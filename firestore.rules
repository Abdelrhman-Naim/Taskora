rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(p)  { return signedIn() && p != null && ('ownerId' in p) && p.ownerId == request.auth.uid; }
    function isMember(p) { return signedIn() && p != null && ('memberIds' in p) && request.auth.uid in p.memberIds; }
    function projectData(pid) { return get(/databases/$(database)/documents/projects/$(pid)).data; }
    function validName(v) { return v is string && v.size() >= 3 && v.size() <= 80; }
    function validDesc(v) { return v is string && v.size() <= 1000; }
    function projectShape(d) {
      return d.keys().hasOnly(['name', 'description', 'ownerId', 'memberIds', 'memberNames', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'description', 'ownerId', 'memberIds', 'memberNames', 'createdAt', 'updatedAt'])
        && validName(d.name) && validDesc(d.description)
        && d.memberIds is list && d.memberIds.size() <= 50 && d.memberIds.hasAll([d.ownerId])
        && d.memberNames is map && d.memberNames.keys().toSet() == d.memberIds.toSet()
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 60
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /notifications/{nid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow create: if signedIn() && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['type','projectId','projectName','taskId','taskTitle','actorId','actorName','createdAt','readAt'])
          && request.resource.data.type in ['task_assigned','comment_added','member_added']
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.readAt == null && request.resource.data.createdAt == request.time
          && request.resource.data.projectName is string && request.resource.data.projectName.size() <= 80
          && (request.resource.data.taskTitle == null || (request.resource.data.taskTitle is string && request.resource.data.taskTitle.size() <= 120))
          && request.resource.data.actorName is string && request.resource.data.actorName.size() >= 1 && request.resource.data.actorName.size() <= 80
          && getAfter(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.memberIds.hasAll([uid, request.auth.uid]);
      }
    }

    match /usersByEmail/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 60;
      allow update, delete: if false;
    }

    match /projects/{pid} {
      allow read: if signedIn() && (resource == null || isMember(resource.data));
      allow create: if signedIn() && projectShape(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(resource.data) && projectShape(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(resource.data);
    }

    match /projects/{pid}/tasks/{tid} {
      function proj() { return projectData(pid); }
      function taskShape(t) {
        return t.keys().hasOnly(['title','description','status','priority','assigneeId','createdBy','dueDate','createdAt','updatedAt','checklist','labels','recurrence','id'])
          && t.keys().hasAll(['title','description','status','priority','createdBy','createdAt','updatedAt'])
          && t.title is string && t.title.size() >= 3 && t.title.size() <= 120
          && t.description is string && t.description.size() <= 1000
          && t.status in ['todo','in_progress','done'] && t.priority in ['low','medium','high']
          && (!('assigneeId' in t) || t.assigneeId == null || t.assigneeId == '' || t.assigneeId in proj().memberIds)
          && (!('dueDate' in t) || t.dueDate == null || t.dueDate == '' || (t.dueDate is string && t.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
          && (!('checklist' in t) || (t.checklist is list && t.checklist.size() <= 20))
          && (!('labels' in t) || (t.labels is list && t.labels.size() <= 5))
          && (!('recurrence' in t) || t.recurrence in ['none','daily','weekly','monthly'])
          && t.updatedAt == request.time;
      }
      function memberMayUpdate() {
        let r = resource.data;
        let uid = request.auth.uid;
        let changed = request.resource.data.diff(r).affectedKeys();
        return (r.createdBy == uid || r.assigneeId == uid)
          && (!changed.hasAny(['status']) || r.assigneeId == uid || (r.assigneeId == null && r.createdBy == uid))
          && (!changed.hasAny(['assigneeId']) || r.createdBy == uid);
      }
      allow read: if isMember(proj());
      allow create: if isMember(proj()) && taskShape(request.resource.data)
        && request.resource.data.status == 'todo'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isMember(proj()) && taskShape(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (isOwner(proj()) || memberMayUpdate());
      allow delete: if isMember(proj()) && (isOwner(proj()) || resource.data.createdBy == request.auth.uid);

      match /comments/{cid} {
        allow read: if isMember(projectData(pid));
        allow create: if isMember(projectData(pid)) && exists(/databases/$(database)/documents/projects/$(pid)/tasks/$(tid))
          && request.resource.data.keys().hasOnly(['authorId','authorName','text','createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && (
            (!('memberNames' in projectData(pid)) || !(request.auth.uid in projectData(pid).memberNames))
              ? (request.resource.data.authorName is string && request.resource.data.authorName.size() >= 1 && request.resource.data.authorName.size() <= 80)
              : (
                  request.resource.data.authorName == projectData(pid).memberNames[request.auth.uid]
                  || request.resource.data.authorName == request.auth.token.name
                  || (request.auth.token.email != null && request.resource.data.authorName == request.auth.token.email)
                )
          )
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isMember(projectData(pid)) && (resource.data.authorId == request.auth.uid
          || isOwner(projectData(pid))
          || get(/databases/$(database)/documents/projects/$(pid)/tasks/$(tid)).data.createdBy == request.auth.uid);
      }
    }

    match /projects/{pid}/activity/{aid} {
      allow read: if isMember(projectData(pid));
      allow create: if isMember(projectData(pid))
        && request.resource.data.keys().hasOnly(['type','actorId','actorName','taskId','taskTitle','detail','createdAt'])
        && request.resource.data.type in ['task_created','task_status_changed','task_assigned','task_deleted','comment_added','member_added','member_removed']
        && request.resource.data.actorId == request.auth.uid
        && (
          (!('memberNames' in projectData(pid)) || !(request.auth.uid in projectData(pid).memberNames))
            ? (request.resource.data.actorName is string && request.resource.data.actorName.size() >= 1 && request.resource.data.actorName.size() <= 80)
            : (
                request.resource.data.actorName == projectData(pid).memberNames[request.auth.uid]
                || request.resource.data.actorName == request.auth.token.name
                || (request.auth.token.email != null && request.resource.data.actorName == request.auth.token.email)
              )
        )
        && (request.resource.data.taskTitle == null || (request.resource.data.taskTitle is string && request.resource.data.taskTitle.size() <= 120))
        && (request.resource.data.detail == null || (request.resource.data.detail is string && request.resource.data.detail.size() <= 200))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(projectData(pid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
