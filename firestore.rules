rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(p)  { return signedIn() && p.ownerId == request.auth.uid; }
    function isMember(p) { return signedIn() && request.auth.uid in p.memberIds; }
    function projectData(pid) { return get(/databases/$(database)/documents/projects/$(pid)).data; }
    function validName(v) { return v is string && v.size() >= 3 && v.size() <= 80; }
    function validDesc(v) { return v is string && v.size() <= 1000; }
    function projectShape(d) {
      return d.keys().hasOnly(['name', 'description', 'ownerId', 'memberIds', 'memberNames', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'description', 'ownerId', 'memberIds', 'memberNames', 'createdAt', 'updatedAt'])
        && validName(d.name) && validDesc(d.description)
        && d.memberIds is list && d.memberIds.size() <= 50 && d.memberIds.hasAll([d.ownerId])
        && d.memberNames is map && d.memberNames.keys().toSet() == d.memberIds.toSet()
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 60
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /usersByEmail/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 60;
      allow update, delete: if false;
    }

    match /projects/{pid} {
      allow read: if signedIn() && (resource == null || isMember(resource.data));
      allow create: if signedIn() && projectShape(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(resource.data) && projectShape(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
